{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Boltay",
  "version": "0.9.0",
  "identifier": "com.relaxlab.boltay",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage", "deb", "app", "dmg"],
    "category": "Productivity",
    "shortDescription": "Offline dictation",
    "longDescription": "Voice dictation for Russian and English that runs on your computer: hold a hotkey, speak, and the text lands where the cursor is. Nothing you say leaves the computer.",
    "publisher": "Relax Lab",
    "copyright": "Relax Lab",
    "license": "MIT",
    "resources": {
      "../../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "Russian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.4",
      "signingIdentity": "-",
      "entitlements": "macos/entitlements.plist",
      "files": {
        "Resources/ru.lproj/InfoPlist.strings": "macos/ru.lproj/InfoPlist.strings"
      }
    }
  }
}
